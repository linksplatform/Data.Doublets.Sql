<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>Platform.Data.Doublets.Sql</PackageId>
    <PackageVersion>0.1.0</PackageVersion>
    <PackageDescription>SQL interface to Doublets data storage</PackageDescription>
    <PackageProjectUrl>https://github.com/linksplatform/Data.Doublets.Sql</PackageProjectUrl>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/linksplatform/Data.Doublets.Sql</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>sql;doublets;database;links</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Platform.Data.Doublets" Version="0.18.1" />
    <PackageReference Include="SqlParserCS" Version="0.1.3" />
    <PackageReference Include="System.Data.Common" Version="4.3.0" />
  </ItemGroup>

</Project>